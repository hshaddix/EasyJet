#!/bin/env python

import os
import re
import yaml
import argparse
import datetime
import subprocess
from shutil import which
from EasyjetHub.steering.utils.config_files import run_config_arg

_DEFAULT_CAMPAIGN = "EJ_%Y_%m_%d_T%H%M%S"


def main():
    parser = argparse.ArgumentParser()

    in_list = parser.add_mutually_exclusive_group(required=True)
    in_list.add_argument(
        "--mc-list",
        help="Text file containing MC datasets")
    in_list.add_argument(
        "--data-list",
        help="Text file containing data datasets"
    )

    parser.add_argument(
        "--run-config",
        type=str,
        required=True,
        help="file path to the runConfig",
    )
    parser.add_argument(
        "--exec",
        type=str,
        default="easyjet-ntupler",
        help="The name of the executable",
    )
    tag_group = parser.add_mutually_exclusive_group()
    tag_group.add_argument(
        "--campaign",
        nargs="?",
        const=_DEFAULT_CAMPAIGN,
        default=None,
        metavar="TEMPLATE",
        help=(
            "strftime template for the campaign name; a datestamp suffix is"
            " appended to ensure uniqueness. With no argument uses"
            f" '{_DEFAULT_CAMPAIGN}'."
        ),
    )
    tag_group.add_argument(
        "--git-tag",
        default=None,
        metavar="TEMPLATE",
        help=(
            "strftime template for an exact git tag (no suffix appended)."
            " Mutually exclusive with --campaign."
        ),
    )
    tag_group.add_argument(
        "-t", "--take-git-tag",
        action="store_true",
        default=False,
        help=(
            "Reuse the single existing tag on HEAD (error if 0 or >1)."
            " Mutually exclusive with --campaign and --git-tag."
        ),
    )
    parser.add_argument(
        "--channels",
        nargs='+',
        default=[],
        help="The list of channels to process. Only relevant if splitOutputTree is used in "
        "the config"
    )
    parser.add_argument(
        "--splitCBK",
        action="store_true",
        help="Store CutBookKeeper in separate file. Only relevant if splitCBK is used in "
        "the config"
    )    
    parser.add_argument(
        "--asetup",
        help="The asetup command, in case it cannot be read from the environment",
    )
    parser.add_argument(
        "--dest-se",
        default=None,
        help="An RSE to duplicate the results to, for example 'DESY-ZN_LOCALGROUPDISK'",
    )
    parser.add_argument(
        "--excluded-site", default=None, help="Any sites to exclude when running"
    )
    parser.add_argument(
        "--nGBperJob", default=None, help="How many GB required per job"
    )
    parser.add_argument(
        "--nFilesPerJob", default=None, help="How many files to process per job"
    )
    parser.add_argument(
        "--maxNFilesPerJob", default=None, help="Max files per job"
    )
    parser.add_argument(
        "--nFiles", default=None, help="How many files to run on"
    )
    parser.add_argument(
        "--nSkipFiles", default=None, help="How many files to skip on"
    )
    parser.add_argument(
        "--memory", default=None, help="How many MB of memory per core to request"
    )
    parser.add_argument(
        "--mergeOutput",
        action="store_true",
        help="Merge outputs (TEfficiency merging requires --mergeWithHadd)",
    )
    parser.add_argument(
        "--mergeWithHadd",
        action="store_true",
        help="Merge outputs with hadd to handle TEfficiency",
    )
    parser.add_argument(
        "--nGBPerMergeJob", default=None, help="The maximum input size in GB to be processed by a single merge job.",
    )
    parser.add_argument(
        "--noSubmit",
        action="store_true",
        help="Don't submit the jobs, just create the tarball",
    )
    parser.add_argument(
        "--noTag",
        action="store_true",
        help="Skip git tag creation",
    )
    parser.add_argument(
        "--noEmail",
        action="store_true",
        help="Don't send panda emails",
    )
    parser.add_argument(
        "--ProductionRole",
        type=str,
        choices=["HMBS", "HIGP", "FLAVTAG"],
        help="Run with production role",
    )
    parser.add_argument(
        "--framework",
        type=str,
        default="easyjet",
        help="The name of the framework to use during submission"
    )

    parser.add_argument(
        "--site",
        type=str,
        required=False,
        help="Specific site on which the jobs should be run"
    )
    parser.add_argument(
        "-p",
        "--output-xaod",
        nargs="?",
        default=None,
        const="output.pool.root",
        metavar="FILE",
        help=(
            "write xAOD/POOL output instead of ROOT TTree;"
            " replaces the default TREE:output-tree.root in"
            " prun --outputs (default filename: output.pool.root)"
        ),
    )
    parser.add_argument(
        "-H",
        "--h5-output",
        nargs="?",
        default=None,
        const="hists.h5",
        metavar="FILE",
        help=(
            "also write HDF5 output;"
            " added to prun --outputs alongside the primary"
            " output. HDF5 files must be merged manually after"
            " job completion using hdf5-merge-nolock"
            " (default filename: hists.h5)"
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "print the prun command that would be submitted"
            " without running prun or checking grid credentials"
        ),
    )
    args = parser.parse_args()

    # check ntupler command is available before submitting
    if not which(args.exec):
        raise RuntimeError(
            f"Failed to find `{args.exec}`."
            " Check that it is installed"
        )

    # check prun is available before submitting
    if not args.dry_run and not which("prun"):
        raise RuntimeError(
            "You have not set up panda, run `lsetup panda`"
        )

    grid_nickname = (
        "testuser" if args.dry_run
        else check_grid_credentials(return_nickname=True)
    )

    now = datetime.datetime.now()

    if args.git_tag is not None:
        git_tag = now.strftime(args.git_tag)
    elif args.take_git_tag:
        git_tag = None  # bash finds the single HEAD tag
    elif args.campaign is not None:
        # explicit template: append suffix so re-runs don't collide
        base = now.strftime(args.campaign)
        git_tag = f"{base}.{now.strftime('%Y_%m_%d_T%H%M%S')}"
    else:
        # default: _DEFAULT_CAMPAIGN already encodes a unique timestamp
        git_tag = now.strftime(_DEFAULT_CAMPAIGN)

    no_push = args.noTag or args.noSubmit or args.dry_run
    campaign = resolve_git_tag(git_tag, no_push=no_push)

    # Prepare some of the prun options here
    submit_opts = {
        "mergeOutput": False,
        "mergeWithHadd": False,
        "writeInputToTxt": "IN:in.txt",
        "useAthenaPackages": True,
    }

    # Primary output: TTree (default) is suppressed whenever
    # --output-xaod or --h5-output is given.
    # --output-xaod and --h5-output can be combined (xAOD + HDF5).
    if args.output_xaod:
        primary_outputs = [args.output_xaod]
        root_outfile = None
    elif args.h5_output:
        # HDF5-only: no TTree
        primary_outputs = []
        root_outfile = None
    elif len(args.channels) > 0:
        primary_outputs = (
            [f"output-tree_{ch}.root" for ch in args.channels]
            + ["output-tree_cbk.root"]
        )
        root_outfile = "output-tree.root"
    elif args.splitCBK:
        primary_outputs = ["output-tree.root", "output-tree_cbk.root"]
        root_outfile = "output-tree.root"
    else:
        primary_outputs = ["TREE:output-tree.root"]
        root_outfile = "output-tree.root"

    if args.h5_output:
        primary_outputs.append(args.h5_output)
    submit_opts["outputs"] = (
        primary_outputs[0] if len(primary_outputs) == 1
        else primary_outputs
    )

    # HDF5-only jobs have a single output type so hdf5-merge-nolock
    # can be used as the prun merge script.
    if args.h5_output and not args.output_xaod and args.mergeOutput:
        submit_opts["mergeScript"] = (
            "hdf5-merge-nolock -o %OUT -i %IN"
        )

    if args.noSubmit:
        submit_opts["noSubmit"] = True
    if args.dest_se is not None:
        submit_opts["destSE"] = args.dest_se
    if args.excluded_site is not None:
        submit_opts["excludedSite"] = args.excluded_site
    if args.nGBperJob is not None:
        submit_opts["nGBPerJob"] = args.nGBperJob
    if args.nGBPerMergeJob is not None:
        submit_opts["nGBPerMergeJob"] = args.nGBPerMergeJob
    if args.nFilesPerJob is not None:
        submit_opts["nFilesPerJob"] = args.nFilesPerJob
    if args.maxNFilesPerJob is not None:
        submit_opts["maxNFilesPerJob"] = args.maxNFilesPerJob   
    if args.nFiles is not None:
        submit_opts["nFiles"] = args.nFiles
    if args.nSkipFiles is not None:
        submit_opts["nSkipFiles"] = args.nSkipFiles
    if args.memory is not None:
        submit_opts["memory"] = args.memory
    if args.mergeOutput:
        submit_opts["mergeOutput"] = True
        if args.mergeWithHadd:
            submit_opts["mergeScript"] = "merge-with-hadd %OUT %IN"
    if args.noEmail:
        submit_opts["noEmail"] = True
    if args.framework:
        submit_opts["framework"] = args.framework
    if args.site:
        submit_opts["site"] = args.site

    if args.asetup is None:
        atlas_project = os.environ["AtlasProject"]

        project_dir = os.environ["{0}_DIR".format(atlas_project)]
        project_version = os.environ["{0}_VERSION".format(atlas_project)]

        if project_dir.startswith("/cvmfs/atlas-nightlies.cern.ch"):
            raise ValueError(
                "Cannot deduce the asetup command for a nightly!"
                + " Use the --asetup option"
            )
        submit_opts["athenaTag"] = ",".join([atlas_project, project_version])
    else:
        submit_opts["athenaTag"] = args.asetup

    # copy the runconfig to the submit dir to be available for the exec cmd
    try:
        with open('config.yaml', 'w') as cfg:
            cfg.write(yaml.dump(run_config_arg(args.run_config)))
    except subprocess.CalledProcessError as e:
        raise OSError(e.returncode, "Failed to copy run config files.")

    if not args.dry_run:
        proc = subprocess.Popen(
            [
                "prun",
                "--outDS",
                "user.{0}.NONE".format(grid_nickname),
                "--exec",
                "NONE",
                "--noSubmit",
                "--useAthenaPackages",
                "--outTarBall",
                "code.tar.gz",
            ]
        )
        if proc.wait() != 0:
            raise OSError(proc.returncode, "Failed to create tarball")
        submit_opts["inTarBall"] = "code.tar.gz"

    io_list = []
    with open(args.mc_list or args.data_list) as fp:
        ds_list = fp.readlines()
    for ds in ds_list:
        ds = ds.strip()
        if ds.startswith("*") or ds.startswith("#"):
            continue
        if not ds:
            continue
        ds_name = ds.rpartition(":")[2]
        ds_name_split = ds_name.split(".")
        ds_tags = ds_name_split[-1]
        if args.mc_list is not None:
            dsid = ds_name_split[1]
        else:
            dsid = f"{ds_name_split[0]}.{ds_name_split[1]}"
        output_ds_name = ""
        if args.ProductionRole:
            if args.ProductionRole.lower() in ["flavtag"]:
                output_ds_name = "group.perf-{0}.{1}.{2}.{3}".format(args.ProductionRole.lower(), campaign, dsid, ds_tags)
            else:
                output_ds_name = "group.phys-{0}.{1}.{2}.{3}".format(args.ProductionRole.lower(), campaign, dsid, ds_tags)
        else:
            if 'Delayed' in ds_name:
                output_ds_name = "user.{0}.{1}.delayed_{2}.{3}".format(grid_nickname, campaign, dsid, ds_tags)
            else:
                output_ds_name = "user.{0}.{1}.{2}.{3}".format(grid_nickname, campaign, dsid, ds_tags)
        io_list.append(
            {
                "inDS": ds_name,
                "outDS": output_ds_name,
            }
        )

    if not io_list:
        raise ValueError("No inputs defined")

    for io in io_list:
        exec_cmd = f"{args.exec} %IN -l --run-config config.yaml"
        if root_outfile:
            exec_cmd += f" --out-file {root_outfile}"
        if args.output_xaod:
            exec_cmd += f" --output-xaod {args.output_xaod}"
        if args.h5_output:
            exec_cmd += f" --h5-output {args.h5_output}"

        cmd = [
            "prun",
            "--inDS", io["inDS"],
            "--outDS", io["outDS"],
            "--notExpandInDS",
            "--exec", exec_cmd,
        ]
        if args.ProductionRole:
            if args.ProductionRole.lower() in ["flavtag"]:
                cmd += [
                    "--voms", "atlas:/atlas/perf-{0}/Role=production".format(args.ProductionRole.lower()),
                    "--official",
                ]
            else:
                cmd += [
                    "--voms", "atlas:/atlas/phys-{0}/Role=production".format(args.ProductionRole.lower()),
                    "--official",
                ]

        for k, v in submit_opts.items():
            if isinstance(v, bool):
                if v:
                    cmd.append(f"--{k}")
            else:
                if isinstance(v, (list, tuple)):
                    v = ",".join(map(str, v))

                cmd += [f"--{k}", v]

        print(" ".join(cmd))
        if not args.dry_run:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE
            )
            out, err = proc.communicate()
            print(out.decode("utf-8"), err.decode("utf-8"))
            if proc.returncode != 0:
                raise OSError(proc.returncode, err)


def check_grid_credentials(return_nickname=False):
    result = subprocess.run(["voms-proxy-info", "--all"], capture_output=True)
    result_output = (result.stdout or result.stderr).decode("utf-8").strip()
    if result.returncode != 0:
        raise RuntimeError(result_output)

    if return_nickname:
        nickname_re = re.search(r'nickname = (\w+)', result_output)
        return nickname_re.group(1) if nickname_re else None


def resolve_git_tag(git_tag: str | None, no_push: bool = False) -> str:
    cmd = ["easyjet-create-git-tag"]
    if no_push:
        cmd.append("--no-push")
    if git_tag is not None:
        cmd.extend(["--git-tag", git_tag])
    result = subprocess.run(cmd, capture_output=True)
    stderr = result.stderr.decode("utf-8").strip()
    stdout = result.stdout.decode("utf-8").strip()
    if stderr:
        print(stderr)
    if result.returncode != 0:
        raise RuntimeError(stderr or stdout)
    return stdout


if __name__ == "__main__":
    main()
