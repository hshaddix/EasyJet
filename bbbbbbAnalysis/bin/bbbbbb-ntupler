#!/bin/env python

#
# Copyright (C) 2002-2026 CERN for the benefit of the ATLAS collaboration
#

import sys
import time
import pathlib

from EasyjetHub.hub import (
    AnalysisArgumentParser,     # lives in ArgumentParser
    analysis_configuration,     # lives in flags
    run_job,                    # lives in run
    default_sequence_cfg,       # lives in main_sequence_config
    output_cfg
)
from EasyjetHub.output.ttree.minituple_config import check_ntuple_output_file
from EasyjetHub.output.h5.h5_config import get_h5_cfg
from EasyjetHub.output.xaod import get_xaod_cfg
from EasyjetHub.algs.event_counter_config import event_counter_cfg

from bbbbbbAnalysis.utils.option_validation_6b import validate_hhh6b_analysis_prerequisites
from bbbbbbAnalysis.config.trihiggs import trihiggs_cfg
from bbbbbbAnalysis.config.resolved import resolved_branches, resolved_trigger_SF_branches, resolved_trigger_bucket_branches
from bbbbbbAnalysis.config.semiresolved import semiresolved_branches
from bbbbbbAnalysis.config.semiboosted import semiboosted_branches
from bbbbbbAnalysis.config.boosted import boosted_branches
from bbbbbbAnalysis.config.trihiggs import pass_branches
from EasyjetHub.algs.orthogonality.orth_config import orth_branches
from EasyjetHub.algs.orthogonality.orth_config import orth_cfg

def hhh6b_parser():
    # Get and customise the parser
    parser = AnalysisArgumentParser()
    parser.add_analysis_arg(
        "--output-hists",
        metavar="HISTS",
        type=pathlib.Path,
        default=False,
        help="save histograms"
    )
    return parser


def hhh6b_job_cfg():
    parser = hhh6b_parser()

    # Fill the configuration flags from the
    # parsed arguments.
    # Returned flags are locked
    flags, args = analysis_configuration(parser)

    validate_hhh6b_analysis_prerequisites(flags)

    # Get a standard ComponentAccumulator with the following infrastructure:
    # - basic services for event loop, messaging etc
    # - apply preselection on triggers and data quality
    # - build event info with calibrations etc
    seqname = "HHH6bSeq"
    cfg = default_sequence_cfg(flags, seqname)

    cfg.merge(
        trihiggs_cfg(flags),
        seqname,
    )

    # Optionally run orthogonality check (only runs if you set do_orth_check to true in your RunConfig)
    extra_orth_branches = []
    if(flags.Analysis.orthogonality.do_orth_check):
        cfg.merge(
            orth_cfg(
                flags,
                smalljetkey=flags.Analysis.container_names.output.reco4PFlowJet,
                photonkey=flags.Analysis.container_names.output.photons,
            ),
            seqname
        )

        extra_orth_branches = orth_branches(flags)

    # Determine the list of output branches
    # For more sophistication this could be done using
    # custom BranchManagers
    bbbbbb_branches = []
    if flags.Analysis.do_semiresolved_trihiggs:
        bbbbbb_extra_branches, float_variable_names = semiresolved_branches(flags)
        bbbbbb_branches += bbbbbb_extra_branches
    if flags.Analysis.do_semiboosted_trihiggs:
        bbbbbb_extra_branches, float_variable_names = semiboosted_branches(flags)
        bbbbbb_branches += bbbbbb_extra_branches
    if flags.Analysis.do_boosted_trihiggs:
        bbbbbb_extra_branches, float_variable_names = boosted_branches(flags)
        bbbbbb_branches += bbbbbb_extra_branches
    if flags.Analysis.do_resolved_trihiggs:
        bbbbbb_extra_branches, float_variable_names = resolved_branches(flags)
        bbbbbb_branches += bbbbbb_extra_branches 
    if flags.Analysis.do_resolved_trigger_SF:
        bbbbbb_extra_branches = resolved_trigger_SF_branches(flags)
        bbbbbb_branches += bbbbbb_extra_branches 
    if flags.Analysis.do_resolved_trigger_bucket:
        bbbbbb_extra_branches = resolved_trigger_bucket_branches(flags)
        bbbbbb_branches += bbbbbb_extra_branches 
    if flags.Analysis.orthogonality.do_orth_check:
        bbbbbb_branches += extra_orth_branches
    if len(flags.Analysis.CutList) > 0:
        bbbbbb_branches += pass_branches(flags)

    # Explicitly call the minituple config because we want to provide
    # additional branches, the list of which is generated dynamically
    # rather than statically in the yaml
    outcfg, ntuple_output_file_list = output_cfg(
        flags,
        seqname,
        bbbbbb_branches)
    cfg.merge(outcfg)
    
    # Record the number of events for logging and tests
    cfg.merge(event_counter_cfg("n_events"), seqname)

    return cfg, flags, args, ntuple_output_file_list


def main():
    # record the total run time
    starttime = time.process_time()

    cfg, flags, args, ntuple_output_file_list = hhh6b_job_cfg()

    if args.dry_run:
        return_code = BootstrapHelper.StatusCode(True)
    else:
        return_code = run_job(flags, args, cfg)
        from os import environ
        outpklfile = environ.get("PICKLECAFILE", None) # check if --stop-after-config
        if return_code and outpklfile is None:
            check_ntuple_output_file(ntuple_output_file_list)

    # this is for unit tests: if jobs run too long something is wrong
    if args.timeout:
        duration = time.process_time() - starttime
        if duration > args.timeout:
            raise RuntimeError(
                f"runtime ({duration:.1f}s) exceed timeout ({args.timeout:.0f}s)"
            )
    return return_code.isSuccess()


# Execute the main function if this file was executed as a script
if __name__ == "__main__":
    is_successful = main()
    sys.exit(0 if is_successful else 1)
