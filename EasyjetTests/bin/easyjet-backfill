#!/usr/bin/env bash

set -Eeu

if [[ -z ${EOS_ACCOUNT_PASSWORD+x} || -z ${EOS_ACCOUNT_USERNAME+x} || -z ${EOS_ACCOUNT_PATH+x} || -z ${EOS_ACCOUNT_PROJECT+x} ]]; then
    echo "eos env not defined, cannot backfill folder"
    exit 1
fi
 
if [[ -z "${CI_MERGE_REQUEST_IID:-}" ]]; then
    echo "merge request ID not defined, cannot backfill folder"
    exit 1
fi

if [[ -z "${VALIDATION_REFERENCE_MR:-}" ]]; then
    echo "reference merge request not defined, cannot backfill folder"
    exit 1
fi

projectdir="root://${EOS_ACCOUNT_PROJECT}.cern.ch"
refeosdir="$EOS_ACCOUNT_PATH/gitlab_ci_output/ntuples/$VALIDATION_REFERENCE_MR"
desteosdir="$EOS_ACCOUNT_PATH/gitlab_ci_output/ntuples/$CI_MERGE_REQUEST_IID"

echo $EOS_ACCOUNT_PASSWORD | kinit -l 1h $EOS_ACCOUNT_USERNAME
klist

# The clean-mr-eos-dir job wipes this MR's ntuples directory at the start
# of every pipeline (before the run stage), so by the time this job runs
# (after the run and validate stages) any file already present here was
# freshly produced by this MR's own pipeline. Anything else must come
# from the reference.
for reffile in $(xrdfs $projectdir ls $refeosdir); do
    filename=$(basename $reffile)
    # skip eos system file
    if [[ "$filename" == .sys.* ]]; then
        echo "skipping system file '${filename}'"
        continue
    fi
    destfile="$desteosdir/$filename"
    if xrdfs "$projectdir" stat "$destfile" > /dev/null 2>&1; then
        echo "skipping '${filename}': already produced by this MR's own pipeline"
        continue
    fi
    echo "backfilling '${filename}' from reference"
    xrdcp --force "${projectdir}//${reffile}" "${projectdir}//${destfile}"
done
